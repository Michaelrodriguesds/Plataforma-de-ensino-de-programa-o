# ============================================================
# Configurações do CodeQuest
# Copie este arquivo para ".env" e preencha.
# ============================================================

# Porta do servidor (no seu PC: http://localhost:3000)
PORT=3000

# Banco de dados MongoDB (Atlas ou local).
# DEIXE VAZIO para guardar tudo no arquivo data/db.json (bom para testar no PC).
# Exemplo Atlas: mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=codequest

# Chave secreta dos logins (invente uma frase grande e aleatória).
# Se ficar vazio, o sistema cria uma sozinho em data/.segredo
JWT_SECRET=

# Fuso horário usado para ofensiva (dias seguidos) e ranking semanal
FUSO_HORARIO=America/Sao_Paulo

# ------------------------------------------------------------
# PAINEL DO DONO (estatísticas): seu nome de usuário no CodeQuest.
# Vários? Separe por vírgula: michael,outra_pessoa
# Depois de entrar no app, aparece o item "📊 Painel" (endereço /app#/admin)
ADMIN_USUARIOS=

# ------------------------------------------------------------
# ANÚNCIOS (Google AdSense) — preencha quando o AdSense aprovar o site
# Código do editor (aparece em AdSense > Conta > Informações da conta)
ADSENSE_CLIENTE=
# Número do bloco de anúncio "Display" responsivo (AdSense > Anúncios > Por bloco de anúncios)
ADSENSE_SLOT=
# 1 = mostra caixas "Espaço do anúncio" para você ver onde eles vão aparecer (sem AdSense)
ANUNCIOS_DEMO=0

# Google Analytics 4 (opcional; o painel próprio já mostra visitas). Ex: G-ABC123XYZ
GA_ID=

# ------------------------------------------------------------
# SITE PÚBLICO
# Endereço do site (usado no sitemap e nos links para o Google). Ex: https://codequest.onrender.com
SITE_URL=
# E-mail de contato que aparece em Sobre, Privacidade e Termos
CONTATO_EMAIL=
# Data mostrada como "última atualização" da política de privacidade
DATA_POLITICA=21/10/2026

# Código de verificação do Google Search Console (método "Tag HTML").
# Cole só o valor de content="...". Ex: GOOGLE_VERIFICACAO=abc123XYZ
GOOGLE_VERIFICACAO=

# (Opcional) Outro arquivo para o banco local, quando não há MONGODB_URI.
# Os testes automáticos usam isso para não mexer nos seus dados.
# ARQUIVO_DADOS=data/db.json
