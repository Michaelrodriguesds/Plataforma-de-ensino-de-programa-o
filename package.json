{
  "name": "codequest",
  "version": "1.2.1",
  "description": "CodeQuest - plataforma gamificada para aprender JavaScript, Python e Java em português",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "validar": "node scripts/validar-conteudo.js",
    "build:dom": "esbuild scripts/dom-entrada.js --bundle --minify --format=iife --platform=browser --target=es2019 --outfile=public/js/runtime/linkedom.js --legal-comments=eof",
    "curriculo": "node scripts/gerar-curriculo.js",
    "restaurar": "node scripts/restaurar-backup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.14"
  }
}
